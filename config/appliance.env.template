# =============================================================================
# Oracle Data Audit & Forensics Appliance — Configuration template
# Copier vers appliance.env et adapter les valeurs
# NE JAMAIS committer ce fichier avec des mots de passe réels
# =============================================================================

# ── Identité ──────────────────────────────────────────────────────────────────
APPLIANCE_NAME=AUDIT-PROD-01
ORG_NAME=Organisation
APPLIANCE_VERSION=1.0.0
APPLIANCE_FQDN=audit.internal.example.com

# ── Base de données ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://audit:CHANGE_ME@localhost/audit
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
API_WORKERS=2
API_LOG_LEVEL=info

# ── Authentification ──────────────────────────────────────────────────────────
# Générer avec : openssl rand -hex 64
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL
JWT_EXPIRE_MINUTES=480
JWT_ALGORITHM=HS256

# MFA (optionnel)
MFA_ENABLED=false
MFA_ISSUER=Oracle Data Audit Appliance

# ── CDC ───────────────────────────────────────────────────────────────────────
CDC_ADAPTER=synchdb
# SynchDB
SYNCHDB_URL=http://synchdb-host:8080
SYNCHDB_API_KEY=
CDC_POLL_INTERVAL_MS=500
CDC_BATCH_SIZE=100

# ── Oracle source ─────────────────────────────────────────────────────────────
ORACLE_HOST=oracle-host.internal
ORACLE_PORT=1521
ORACLE_SERVICE=COREBANK
# Les credentials Oracle sont dans .oracle_secrets (permissions 600)

# ── Rétention ─────────────────────────────────────────────────────────────────
RETENTION_HOT_DAYS=90
RETENTION_WARM_DAYS=365
RETENTION_COLD_DAYS=2555
RETENTION_MIN_RISK_KEEP=HIGH

# ── Archive ───────────────────────────────────────────────────────────────────
ARCHIVE_FORMAT=parquet
ARCHIVE_BACKEND=filesystem
ARCHIVE_LOCAL_PATH=/var/lib/audit-appliance/archive

# S3 / MinIO (si ARCHIVE_BACKEND=s3)
ARCHIVE_S3_ENDPOINT=http://minio:9000
ARCHIVE_S3_BUCKET=audit-archive
ARCHIVE_S3_ACCESS_KEY=
ARCHIVE_S3_SECRET_KEY=
ARCHIVE_S3_PREFIX=audit-archive/

# ── Alertes ───────────────────────────────────────────────────────────────────
# Email
ALERT_EMAIL_ENABLED=true
ALERT_EMAIL_TO=security@example.com
ALERT_EMAIL_FROM=audit-appliance@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

# Webhook (Teams, Slack, ntfy...)
ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URL=

# SIEM Syslog
ALERT_SYSLOG_ENABLED=false
ALERT_SYSLOG_HOST=siem.internal
ALERT_SYSLOG_PORT=514

# ── Backup ────────────────────────────────────────────────────────────────────
BACKUP_DEST=local
BACKUP_LOCAL_PATH=/mnt/backup
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=audit-backup
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# Clé de chiffrement AES-256 — NE PAS PERDRE
BACKUP_ENCRYPT_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL
BACKUP_API_TOKEN=CHANGE_ME

# ── Seuils de surveillance ────────────────────────────────────────────────────
DISK_ALERT_THRESHOLD_GB=20
DISK_CRITICAL_THRESHOLD_GB=5
CDC_LAG_ALERT_SECONDS=30
CDC_LAG_CRITICAL_SECONDS=300

# ── Logs ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
# Ne jamais mettre à DEBUG en production (risque d'exposition de données)

# ── Intégrité ─────────────────────────────────────────────────────────────────
INTEGRITY_CHECKPOINT_EVERY_N_EVENTS=1000
INTEGRITY_AUTO_VERIFY=true
INTEGRITY_VERIFY_INTERVAL_HOURS=6

# ── Performance ───────────────────────────────────────────────────────────────
ENGINE_MAX_QUEUE_SIZE=10000
ENGINE_WORKER_CONCURRENCY=4
RULE_RELOAD_INTERVAL_SECONDS=60
