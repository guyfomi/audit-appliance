{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "default": {
      "format": "%(asctime)s %(levelname)s %(name)s %(message)s"
    }
  },
  "handlers": {
    "default": {
      "formatter": "default",
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stdout"
    }
  },
  "loggers": {
    "audit-api": {
      "handlers": ["default"],
      "level": "INFO"
    }
  },
  "root": {
    "handlers": ["default"],
    "level": "INFO"
  }
}